//----------------------------------------------------
//   
//    Pause-Query
//
//----------------------------------------------------
//
RESOURCE DIALOG r_journey_pause_query
    {
    flags = EGeneralQueryFlags;
	buttons = r_journey_softkeys_end_resume;

    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_CONFIRMATION_QUERY
                {
                layout = EConfirmationQueryLayout;
                label = qtn_game_paused;
                };
            }
        };
    }


//-----------------------------------------------------------------------------
//    Softkeys for pause
//
RESOURCE CBA r_journey_softkeys_end_resume
{
	buttons =
    {
		CBA_BUTTON {id = EJourneyCmdPauseEnd;    txt = qtn_end;	} ,
	    CBA_BUTTON {id = EJourneyCmdPauseResume; txt = qtn_resume;	}
    };
}


