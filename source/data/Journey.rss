    {
    menubar=r_journey_menubar_view1;  
    cba=r_journey_softkeys_options_exit;    
    }

//----------------------------------------------------
RESOURCE CBA r_journey_softkeys_options_exit
    {
    buttons =
        {
        CBA_BUTTON {id = EJourneyCmdMenu; txt = qtn_menu_options;  },
        CBA_BUTTON {id = EJourneyCmdExit; txt = qtn_menu_exit; }
        };
    }

