// LOCALISATION STRINGS

#define qtn_menu_options "Опции"

#define qtn_menu_continue "Продолжить"
#define qtn_menu_startgame "Начать новую"
#define qtn_menu_about "О программе"
#define qtn_about_text "The Journey v1.40\nMopius, 2011\nwww.mopius.com\nRussian translation:\n[wl]"
#define qtn_menu_exit "Выход"
#define qtn_menu_return "Вернуться в меню"
#define qtn_menu_accept "Принять"

#define qtn_game_paused			"Пауза.\nЗакончить игру?"
#define qtn_end  				"Закончить"
#define qtn_resume				"Продолжить"

#define qtn_continue			"Продолжить"

#define qtn_app_caption_string "The Journey"

#define qtn_app_short_caption_string "The Journey"

#define qtn_info_text "Игра «The Journey» - это демоверсия, позволяющая стать участником истории, действие которой разворачивается в Вашей местности. Во время игры Вам необходимо физически передвигаться, чтобы попасть на следующее виртуальное место действия. В городе это может быть всего лишь 100 метров, а за городом, возможно, Вам придётся преодолеть несколько километров.\nИгра «The Journey – II» основана на подобном принципе и предлагает большой интерактивный мир, который Вы сможете исследовать."

#define qtn_privacy_text "К вашему сведению:\nЭтому приложению требуется следующее свойство вашего телефона:\n\n- Косвенное определение вашего местоположения посредством запроса ID ближайшей базовой станции. Эта информация не используется для шпионажа за вашими перемещениями и остается в вашем телефоне.\n\nЕсли у вас есть вопросы или предложения, пожалуйста, напишите нам на contact@mopius.com"

#define qtn_loading "Загрузка..."
#define qtn_wrongarea_notpossible "Ошибка."
#define qtn_nonet "Невозможно получить местоположение. Возможно, не ловит сеть. Если это не так, попытайтесь инициировать звонок и перезагрузить игру."
#define qtn_nogsm "Невозможно определить ваше местоположение. Ваш телефон не использует требуемый тип сети."
#define qtn_offline "Невозможно определить ваше местоположение. Доступ с сервису запрещен - возможно ваш телефон в режиме самолета."

#define qtn_areaname_NO "Улицы"
#define qtn_areaname_00 "Детективное Бюро"
#define qtn_areaname_01 "Бар"
#define qtn_areaname_02 "Старая фабрика"

#define qtn_story_000 "Как обычно, вы сидите в своем старом кожанном кресле, одетый в ваш поношенный плащ. Поздний вечер, и уже несколько дней идет дождь. Клиенты не заходят в детективное борю так поздно, но вам все равно нечего делать. Неожиданно дверь открылась со скрипящим звуком и вошла темная, высокая фигура. С каждым шагом она оставляла за собой лужи воды от дождя, идущего снаружи."
#define qtn_story_001 "Он подошел к вашему столу, сел и стал смотреть на вас, не говоря ни слова. Вы не многое можете разглядеть в нем, потому что его полное лицо скрыто в тени его темного капюшона. Он начал говорить тусклым голосом. 'Вы лучший детектив из тех, о ком я слышал.' - похоже, он не ждал ответа. 'У меня есть для вас предложение. Вам всего лишь нужно найти кое-кого для меня и я позабочусь о вашем финансовом положении.'"
#define qtn_story_002 "Он достал старую фотографию из кармана и показал вам. 'У меня есть только это фото. Все, что я могу рассказать вам - это то, что он украл у меня что-то важное, и что он часто бывает в баре, называемом >Таверна Шлабо<'. Подходящее место для начала поисков.'"
#define qtn_story_003 "После короткой паузы он продолжил. 'Вас заинтересовало мое предложение?'. То, как он посмотрел на вас, заставило вас почувствовать, что у вас нет другого выбора, и не важно, чего вы там хотите. Вы кивнули. Получив ожидаемый ответ, он сказал 'Хорошо. Я вернусь позднее. Надеюсь, вы его поймаете.'. Без дальнейших комментариев, он встал и вышел. Окей, вам лучше начать поиски с бара!"

#define qtn_story_004 "В дождливой ночи вы увидели слово >Бар<, написанное с помощью зеленых, мерцающих flickering флюоресцентных трубок - это >Таверна Шлабо<. Без колебаний, вы вошли в бар и прошли мимо мускулистого вышибалы. Вы заняли место у стойки, заказали пиво и показали барменше фотографию, которую вам дал ваш клиент."
#define qtn_wrongarea_004_NO "Продолжайте поиски бара. Он должен быть рядом с вашим текущим положением."
#define qtn_wrongarea_004_00 "Вам нужно найти бар. Покиньте бюро и прогуляйтесь по улицам!"
#define qtn_story_005 "Сначала она делала вид, что ничего не знает, но после нескольких банкнот, она вспомнила, 'Почти каждый день он сидел за столом около входа. Последние несколько дней он не показывался, не знаю почему. Может быть, тот парень в черной куртке сможет помочь вам, я видела, как они довольно часто общались...' Вы поблагодарили её и направились к столу."
#define qtn_wrongarea_005_NO "Вернитесь в бар, чтобы получить больше информации!"
#define qtn_story_006 "Он был не очень дружелюбным, но после того, как вы показали ему фотографию, он поглядел на вас измученным заботами взглядом. Он начал говорить с вами, 'Меня зовут Ричард, парень, которого вы ищите, мой друг, его зовут Бен, и я уже немного беспокоюсь за него. Я не видел его несколько лет, последнее, что я о нем слышал - то, что он был вовлечен в какое-то рискованное дело со странным парнем.'"
#define qtn_story_007 "После короткой паузы он продолжил - 'Я могу показать вам путь на старую фабрику за городом, может, там мы найдем Бена...' Вы решили поверить Ричарду и пошли к машине. Следуйте его инструкциям, чтобы найти старую фабрику!"

#define qtn_story_008 "Вы нашли старую фабрику. Похоже, она закрыта уже несколько лет. С осторожностью вы и Ричард вошли в холл и нашли связанного Бена в углу. Ричард подбежал к нему и освободил его от узов. Бен тут же начал говорить, 'Он хотел убить меня! Мы должны найти его как можно быстрее, он задумал что-то очень, очень плохое...' Вы знаете, кого имеет в виду Бен."
#define qtn_wrongarea_008_NO "Просто двигайтесь прямо некоторое время и тогда мы достигнем нашей цели."
#define qtn_wrongarea_008_00 "Мы не там, вы должны ехать в другом направлении."
#define qtn_wrongarea_008_01 "Ричард повел вас - 'Едьте в том направлении' - и указал на улицу, ведущую от бара."
#define qtn_story_009 "Вы ответили, 'Он вернется в мое бюро позднее. Мы можем поехать туда и подождать его, тогда мы сможем его арестовать.' Бен и Ричард согласились с вашим планом и сели в вашу машину, чтобы ехать в ваше бюро."
#define qtn_wrongarea_009_NO "Вернитесь в холл фабрики, чтобы получить больше информации!"

#define qtn_story_010 "Через несколько секунд после того, как вы вошли в бюро, злой черный парень вошел и посмотрел с легким удивлением. Низким голосом он сказал, 'Хорошо. Вы нашли его.'"
#define qtn_wrongarea_010_NO "Вернитесь в свое бюро, туда, где вы встретились со злым парнем. Торопитесь!"
#define qtn_wrongarea_010_01 "Вернитесь в свое бюро, туда, где вы встретились со злым парнем. Торопитесь!"
#define qtn_wrongarea_010_02 "Покиньте фабрику и вернитесь в свое бюро, туда, где вы встретились со злым парнем. Торопитесь!"
#define qtn_story_011 "Внезапно Ричард и Бен достали оружие и направили на злого парня и - на вас! Сначала вы были в недоумении, но затем все поняли. Зачем было плохому на вид парню связывать Бена и затем просить вас найти его? Бен просто сыграл с вами шутку и связал себя сам, чтобы вы привели его к его врагу... Вы стараетесь подумать о том, что делать дальше. Вы в ловушке, Бен подошел к двери, чтобы никто не сбежал, пока Ричард обыскивает комнату."
#define qtn_wrongarea_011_NO "Пауза. Вернитесь в бюро, чтобы продолжить игру."
#define qtn_story_012 "Совершенно неожиданно дверь открылась, уронив Бена. Вы обернулись, достали ваш револьвер и выстрелили Ричарду в ногу. После того, как вы и темный парень позаботились об обоих, вы получили шанс посмотреть на вошедшего. Вы не поверили своим глазам - это была прекрасная леди, которая упала в обморок. Похоже у вас новый клиент. Вы просто обязаны пригласить ее в бар, как только закончится это дело."
#define qtn_story_013 "Темный парень поблагодарил вас и сказал, что в реальности он полицейский и что он месяцами безуспешно искал Бена. С вашей помощью, этот долгий, безуспешный поиск закончился. Вы вернулись назад в ваше кресло и и подумали о предстояшей встрече с леди в баре..."
#define qtn_story_014 "Поздравляем! Вы герой города, хотя и на один день..."

// End of File
